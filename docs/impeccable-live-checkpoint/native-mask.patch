+            AbsolutePathBuf::try_from(workspace.path()).unwrap(),
+            profile,
+            create_env_from_core_vars(),
+            LONG_TIMEOUT_MS,
+            /*use_legacy_landlock*/ false,
+        ).await.expect("native sandbox must launch without directory/file mask collision");
+        let stderr_class = if output.stderr.text.contains("Is a directory") {
+            "EISDIR"
+        } else if output.stderr.text.contains("Not a directory") {
+            "ENOTDIR"
+        } else if output.stderr.text.contains("Permission denied") {
+            "EACCES"
+        } else if output.stderr.text.contains("Read-only file system") {
+            "EROFS"
+        } else if output.stderr.text.contains("No such file or directory") {
+            "ENOENT"
+        } else {
+            "unclassified"
+        };
+        assert_eq!(output.exit_code, 0,
+            "NATIVE_METADATA_EXIT kind={kind} exitCode={} stderrClass={stderr_class} stdoutBytes={} stderrBytes={}",
+            output.exit_code, output.stdout.text.len(), output.stderr.text.len());
+        assert_eq!(output.stdout.text, "instructionsdenied");
+        assert_eq!(std::fs::read_to_string(workspace.path().join("public")).unwrap(), "allowed");
+        if kind == "directory" {
+            assert_eq!(std::fs::read_to_string(metadata.join("config.toml")).unwrap(), "private fixture");
+        } else if kind == "file" {
+            assert_eq!(std::fs::read_to_string(&metadata).unwrap(), "private fixture");
+        } else if kind == "empty-directory" {
+            assert!(metadata.is_dir(), "pre-existing empty directory must be preserved");
+        } else if kind == "empty-file" {
+            assert!(metadata.is_file(), "pre-existing empty file must be preserved");
+        }
+    }
+}
